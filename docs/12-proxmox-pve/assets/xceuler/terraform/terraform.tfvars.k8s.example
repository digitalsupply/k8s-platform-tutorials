# 示例：用同一套 Terraform 模块创建 3 台“K8s 节点候选 VM”。
#
# 注意：
#   1. 这些 VMID/IP 是示例，不要与现有 119-124 冲突；
#   2. 真正加入现有集群前，必须确认 kubelet/containerd 版本与集群一致；
#   3. Ceph-CSI 3.18 标准镜像要求 x86-64-v3，因此这里显式设置 vm_cpu_type。
#   4. 现有 K8s 节点是双网卡（vmbr1 管理网 + vmbr2 业务网），本模块只建单网卡；
#      需要双网卡时复制 network_device + ip_config（见教程 01 章）。

proxmox_endpoint  = "https://127.0.0.1:8006/"
proxmox_api_token = "<redacted-proxmox-api-token>"
proxmox_node      = "teacher"
template_vmid     = 9010

vm_user     = "hao"
vm_bridge   = "vmbr1"
vm_gateway  = "10.0.0.1"
vm_dns      = "223.5.5.5"
vm_cores    = 4
vm_memory   = 4096
vm_cpu_type = "x86-64-v3"

vms = {
  k8s-lab-w01 = { vmid = 130, ip = "10.0.0.130" }
  k8s-lab-w02 = { vmid = 131, ip = "10.0.0.131" }
  k8s-lab-w03 = { vmid = 132, ip = "10.0.0.132" }
}
